    "open:ios": "APP_SYNC_PLATFORM=ios cap open ios",
    "assets": "capacitor-assets generate --assetPath ../../app-sync/brand"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
