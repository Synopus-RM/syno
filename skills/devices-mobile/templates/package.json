{
  "name": "{{SLUG}}-mobile",
  "private": true,
  "version": "{{VERSION}}",
  "description": "{{APP_NAME}} mobile app (Android, iOS)",
  "scripts": {
    "sync:android": "APP_SYNC_PLATFORM=android cap sync android",
    "sync:ios": "APP_SYNC_PLATFORM=ios cap sync ios",
