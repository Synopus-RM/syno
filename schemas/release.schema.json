{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rishimurugan-synopus/syno/schemas/release.schema.json",
  "title": "Chronicle release (.syno/releases/<version>.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "date",
    "status",
    "changes",
    "ideas",
    "channels",
    "source"
  ],
  "additionalProperties": false,
  "$defs": {
    "change": {
      "type": "object",
      "required": [
        "id",
        "type",
        "summary",
        "breaking",
        "ideas",
        "created"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{6}-[a-z0-9-]+$"
        },
        "type": {
          "enum": [
            "Added",
            "Changed",
            "Deprecated",
            "Removed",
            "Fixed",
            "Security"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "details": {
          "type": "string"
        },
        "breaking": {
          "type": "boolean"
        },
        "ideas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IDEA-\\d{4,}$"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "format": "uri-http"
              }
            }
          }
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "publish": {
      "type": "object",
      "required": [
        "channel",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "enum": [
            "planned",
            "published",
            "yanked"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-http"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "released",
        "yanked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^IDEA-\\d{4,}$"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publish"
      }
    },
    "git": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "source": {
      "enum": [
        "syno",
        "adopted-tag",
        "adopted-changelog",
        "synced-tag"
      ]
    },
    "yanked": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "date",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
