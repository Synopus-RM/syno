{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rishimurugan-synopus/syno/schemas/snapshot.schema.json",
  "title": "Chronicle structure snapshot (.syno/snapshots/<version|baseline|YYYY-MM-DD>.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "date",
    "source",
    "depth",
    "totals",
    "folders",
    "diffFromPrevious"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "enum": [
        "git-tree",
        "filesystem"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "totals": {
      "type": "object",
      "required": [
        "files",
        "bytes"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "files",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "diffFromPrevious": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "previous": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renamed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "topLevel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "filesDelta",
              "bytesDelta"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "filesDelta": {
                "type": "integer"
              },
              "bytesDelta": {
                "type": "integer"
              }
            }
          }
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "bytes"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
