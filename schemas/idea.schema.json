{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rishimurugan-synopus/syno/schemas/idea.schema.json",
  "title": "Chronicle idea (.syno/ideas/IDEA-0001.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "statusHistory",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^IDEA-\\d{4,}$",
      "patternHint": "an idea ID like IDEA-0001"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "problem": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "planned",
        "in-progress",
        "shipped",
        "parked",
        "rejected"
      ]
    },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "status",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "planned",
              "in-progress",
              "shipped",
              "parked",
              "rejected"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "shippedIn": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "patternHint": "a version like 1.2.0 or 1.2.0-rc.1"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "format": "uri-http"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    }
  }
}
