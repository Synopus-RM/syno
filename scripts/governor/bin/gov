#!/bin/sh
# Lets Claude (and you) type `gov` instead of the full node path; follows symlinks back to the plugin.
self="$0"
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self="$dir/$self" ;; esac
done
exec node "$(cd "$(dirname "$self")" && pwd)/../gov.js" "$@"
